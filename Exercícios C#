j) using System;

class Program
{
    public static void Main(string[] args)
    {
        const int TOTAL = 40;
        string[] nome = new string[TOTAL];
        int[] quantidade = new int[TOTAL];
        double[] preco = new double[TOTAL];
        bool cadastrado = false;
        int opcao;

        do
        {
            Console.Clear();
            Console.WriteLine("MENU");
            Console.WriteLine("1. Cadastra mercadorias");
            Console.WriteLine("2. Exibe valor total em mercadorias da empresa");
            Console.WriteLine("3. Sair");
            Console.Write("OPÇÃO: ");
            opcao = int.Parse(Console.ReadLine());

            switch (opcao)
            {
                case 1:
                    for (int i = 0; i < TOTAL; i++)
                    {
                        Console.WriteLine();
                        Console.WriteLine("Mercadoria " + (i + 1) + " de " + TOTAL + ":");
                        Console.Write("  Nome: ");
                        nome[i] = Console.ReadLine();
                        Console.Write("  Quantidade em estoque: ");
                        quantidade[i] = int.Parse(Console.ReadLine());
                        Console.Write("  Preço unitário: ");
                        preco[i] = double.Parse(Console.ReadLine());
                    }
                    cadastrado = true;
                    Console.WriteLine();
                    Console.WriteLine("Mercadorias cadastradas com sucesso!");
                    break;

                case 2:
                    if (!cadastrado)
                    {
                        Console.WriteLine("Cadastre as mercadorias primeiro (opção 1).");
                    }
                    else
                    {
                        double valorTotal = 0;
                        for (int i = 0; i < TOTAL; i++)
                        {
                            valorTotal += quantidade[i] * preco[i];
                        }
                        Console.WriteLine("Valor total em mercadorias: R$ " + valorTotal.ToString("F2"));
                    }
                    break;

                case 3:
                    Console.WriteLine("Encerrando o programa...");
                    break;

                default:
                    Console.WriteLine("Opção inválida!");
                    break;
            }

            if (opcao != 3)
            {
                Console.Write("Pressione qualquer tecla para voltar ao menu . . . ");
                Console.ReadKey(true);
            }
        } while (opcao != 3);

        Console.Write("Pressione qualquer tecla para continuar . . . ");
        Console.ReadKey(true);
    }
}
